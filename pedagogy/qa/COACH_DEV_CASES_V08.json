            "Supposer un accord confirmé"
          ]
        },
        {
          "student": "Juste une phrase possible, aucune question pour nous.",
          "look_for": [
            "Une formulation adaptable",
            "Respect de la contrainte"
          ],
          "red_flags": [
            "Jeu de rôle imposé"
          ]
        }
      ]
    },
    {
