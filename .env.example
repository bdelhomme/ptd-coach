# Only examples. Do not use personal data or commit real values.
APP_ENV=development
AI_PROVIDER=mock
# A2 always stays on AI_PROVIDER=mock. The independent conversation uses:
CHAT_PROVIDER=mistral
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_KEY=
CHAT_MAX_TOKENS=700
CHAT_TIMEOUT_SECONDS=45
# Max attempted calls across the persistent conversation database, including errors.
CHAT_MAX_CALLS=100
# CHAT_PROVIDER=mock gives an explicitly labelled offline conversation demo.
# DATABASE_URL=postgresql://ptd:local_password@db:5432/ptd
# ANONYMIZED_LOGS_ONLY=true
