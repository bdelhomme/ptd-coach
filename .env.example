# Only examples. Do not use personal data or commit real values.
APP_ENV=development
AI_PROVIDER=mock
# A2 always stays on AI_PROVIDER=mock. The independent conversation uses:
CHAT_PROVIDER=mistral
# V2 uses GLM 5.3 Flash by default. Set this to override the model.
# MISTRAL_MODEL=zai-glm-5-3-flash
MISTRAL_API_KEY=
# Pour essayer Albert API, sélectionnez CHAT_PROVIDER=albert et ajoutez la clé locale.
ALBERT_API_KEY=
# ALBERT_MODEL=openai/gpt-oss-120b
# V2 with Flash defaults to 2000. Set this to override the cap.
# CHAT_MAX_TOKENS=2000
CHAT_TIMEOUT_SECONDS=45
# Max attempted calls across the persistent conversation database, including errors.
CHAT_MAX_CALLS=100
# CHAT_PROVIDER=mock gives an explicitly labelled offline conversation demo.
# DATABASE_URL=postgresql://ptd:local_password@db:5432/ptd
# ANONYMIZED_LOGS_ONLY=true
# GLM 5.3 Flash: low, high, max. Mistral Large 4: low, medium, high.
MISTRAL_REASONING_EFFORT=low
