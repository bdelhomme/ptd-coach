{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ptd-coach/coach-response-v0.1.schema.json",
  "title": "CoachResponse v0.1 proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message",
    "pedagogical_intent",
    "proposed_updates",
    "needs_human_support"
  ],
  "properties": {
    "message": {
      "type": "string"
    },
    "pedagogical_intent": {
      "type": "string"
    },
    "suggested_next_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "proposed_updates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "needs_human_support": {
      "type": "boolean"
    }
  }
}
